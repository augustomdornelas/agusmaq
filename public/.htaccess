# ---------------------------------------------------------------------------
# Agusmaq — SPA estatica servida por Apache/LiteSpeed (Hostinger compartilhada).
#
# Este arquivo fica em public/ e o Vite o copia para dist/client/ no build.
# Ele precisa ficar na RAIZ de public_html, ao lado do index.html.
# ---------------------------------------------------------------------------

# MultiViews faz o Apache "adivinhar" arquivos (serve /index para /index.html)
# e quebra o roteamento da SPA. Desligar e obrigatorio.
Options -MultiViews
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# 1) HTTPS e roteamento da SPA
#
#    ATENCAO: instale o certificado SSL no hPanel ANTES de subir este arquivo.
#    O redirect e 301 (permanente) e o navegador guarda isso — se o certificado
#    ainda nao existir, o visitante toma erro de certificado e continua tomando
#    mesmo depois de voce arrumar. Enquanto estiver testando, troque R=301 por
#    R=302 na linha do RewriteRule abaixo.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcar HTTPS. As duas condicoes juntas evitam loop de redirect: na Hostinger
  # o TLS termina num proxy na frente do Apache, entao %{HTTPS} chega "off" mesmo
  # numa requisicao que ja era https — quem diz a verdade nesse caso e o header
  # X-Forwarded-Proto. So redireciona quando os dois indicam que nao e https.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Roteamento: toda rota interna cai no index.html.
  # Sem isto, /catalogo e /portal/dashboard dao 404 ao recarregar — o Apache
  # procura uma pasta com esse nome no disco e nao acha. O router do React
  # resolve a rota no navegador depois que o index.html carrega.

  # Arquivos e pastas que existem de verdade (assets, favicon.png) sao servidos
  # direto, sem reescrita.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra URL -> index.html, com status 200.
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 2) MIME types — evita "Failed to load module script" se o servidor devolver
#    os .js como text/plain.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript              .js .mjs
  AddType text/css                     .css
  AddType image/svg+xml                .svg
  AddType application/json             .json
  AddType font/woff                    .woff
  AddType font/woff2                   .woff2
  AddType image/webp                   .webp
</IfModule>

# ---------------------------------------------------------------------------
# 3) Compressao
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ---------------------------------------------------------------------------
# 4) Cache
#    /assets/* tem hash no nome a cada build -> pode cachear pra sempre.
#    O index.html NAO pode ser cacheado, senao o usuario continua vendo a
#    versao antiga depois de um deploy novo.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/assets/" AGUSMAQ_IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=AGUSMAQ_IMMUTABLE

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
</IfModule>
